platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# flutter_local_db ships one dylib per architecture and its podspec links BOTH
# into every slice of the universal build, so ld warns twice ("found
# architecture 'arm64', required architecture 'x86_64'" and the reverse) and
# drops the mismatched one. Linking each dylib only into its own slice is the
# same binary, without the warnings. Its loader still needs the library linked
# (it tries `DynamicLibrary.process()` first), so the flags move, not go.
LOCAL_DB_DYLIBS = {
  'arm64' => '-l"offline_first_core_arm64"',
  'x86_64' => '-l"offline_first_core_x86_64"',
}.freeze

def link_local_db_per_arch(support_files_dir)
  Dir.glob(File.join(support_files_dir, '**', '*.xcconfig')).each do |path|
    lines = File.read(path).lines
    index = lines.index { |line| line.start_with?('OTHER_LDFLAGS = ') }
    next unless index && LOCAL_DB_DYLIBS.values.all? { |flag| lines[index].include?(flag) }

    base = LOCAL_DB_DYLIBS.values.reduce(lines[index].chomp) { |line, flag| line.sub(" #{flag}", '') }
    per_arch = LOCAL_DB_DYLIBS.map do |arch, flag|
      "#{base.sub('OTHER_LDFLAGS = ', "OTHER_LDFLAGS[arch=#{arch}] = ")} #{flag}\n"
    end
    lines[index] = "#{base}\n"
    lines.insert(index + 1, *per_arch)
    File.write(path, lines.join)
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    end
  end
  link_local_db_per_arch(installer.sandbox.target_support_files_root.to_s)
end
