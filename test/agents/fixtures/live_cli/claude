#!/usr/bin/env bash
# Fake `claude` for the live-session test. Every turn answers with the pid of
# the process that served it, so the chat itself shows whether two turns shared
# one process or paid for two.
turn() {
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"fake-live-session","model":"sonnet"}'
  printf '{"type":"assistant","message":{"content":[{"type":"text","text":"pid=%s"}]}}\n' "$$"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"pid=%s","total_cost_usd":0,"duration_ms":1,"usage":{"input_tokens":1,"output_tokens":1}}\n' "$$"
}

for arg in "$@"; do
  if [ "$arg" = "--input-format" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && turn
    done
    exit 0
  fi
done
turn
