#!/usr/bin/env python3
"""A provider with no channel for mid-turn messages, like `codex exec`: the
prompt is the last argv. The first turn stays in its tool until it is killed;
the resumed turn logs the prompt it got and closes the node."""
import json
import os
import sys
import time
from pathlib import Path

args = sys.argv[1:]
# `codex debug models`: Keel reads the catalog; nothing to run.
if args[:2] == ['debug', 'models']:
    print(json.dumps({'models': [{'slug': 'gpt-5', 'display_name': 'GPT-5',
                                  'visibility': 'list', 'priority': 1}]}))
    sys.exit(0)
prompt = args[-1]
resume = 'resume' in args


def emit(event):
    print(json.dumps(event), flush=True)


with Path('invocations.log').open('a') as out:
    out.write(f'{os.getpid()} {"resume" if resume else "new"}\n')
emit({'type': 'thread.started', 'thread_id': 'fake-codex-steer'})
if not resume:
    Path('turn-waiting').write_text('1')
    time.sleep(30)
    sys.exit(0)
Path('resumed-prompt.txt').write_text(prompt)
answer = ('Seguí desde donde quedé.\n```keel-outcome\nstatus: done\n'
          'summary: Apliqué el mensaje y cerré el nodo.\n```')
emit({'type': 'item.completed', 'item': {'id': 'i1', 'type': 'agent_message', 'text': answer}})
emit({'type': 'turn.completed', 'usage': {'input_tokens': 1, 'cached_input_tokens': 0, 'output_tokens': 1}})
